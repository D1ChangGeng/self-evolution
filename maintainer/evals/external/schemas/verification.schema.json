{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://self-evolution.invalid/evals/external/verification.schema.json",
  "title": "External run verification evidence",
  "$defs": {
    "artifactBinding": {
      "type": "object",
      "required": ["path", "artifact_sha256", "value_sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "artifact_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "value_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      },
      "additionalProperties": false
    }
  },
  "type": "object",
  "required": [
    "schema_version",
    "task_id",
    "attempt",
    "blind_label",
    "hidden_tests",
    "full_suite",
    "regression_safety",
    "focused",
    "full",
    "clean_install",
    "patch_safety",
    "patch_sha256",
    "changed_paths_sha256",
    "patch_binding_sha256",
    "artifact_bindings"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "task_id": { "type": "string", "minLength": 1 },
    "attempt": { "type": "integer", "minimum": 1, "maximum": 3 },
    "blind_label": { "type": "string", "pattern": "^arm-[0-9a-f]{12}$" },
    "hidden_tests": { "enum": ["pass", "fail"] },
    "full_suite": { "enum": ["pass", "fail"] },
    "regression_safety": { "enum": ["pass", "fail"] },
    "patch_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "changed_paths_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "patch_binding_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "artifact_bindings": {
      "type": "object",
      "required": [
        "focused",
        "full",
        "clean_install",
        "patch_safety",
        "binding_sha256"
      ],
      "properties": {
        "focused": { "$ref": "#/$defs/artifactBinding" },
        "full": { "$ref": "#/$defs/artifactBinding" },
        "clean_install": { "$ref": "#/$defs/artifactBinding" },
        "patch_safety": { "$ref": "#/$defs/artifactBinding" },
        "binding_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
