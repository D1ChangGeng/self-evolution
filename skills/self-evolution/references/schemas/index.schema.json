{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Self-Evolution v2 generated index",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "documents"],
  "properties": {
    "schema_version": { "const": "2.0" },
    "documents": {
      "type": "array",
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/guideEntry" },
          { "$ref": "#/$defs/decisionEntry" }
        ]
      }
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1,
      "pattern": ".*\\S.*"
    },
    "guidePath": {
      "type": "string",
      "pattern": "^guides/(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+\\.md$"
    },
    "decisionPath": {
      "type": "string",
      "pattern": "^decisions/(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+\\.md$"
    },
    "scope": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/nonEmptyString" }
    },
    "guideEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "kind", "status", "scope", "use_when"],
      "properties": {
        "path": { "$ref": "#/$defs/guidePath" },
        "kind": { "enum": ["guide", "runbook", "map", "policy"] },
        "status": { "const": "active" },
        "scope": { "$ref": "#/$defs/scope" },
        "use_when": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        }
      }
    },
    "decisionEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "kind", "id", "status", "date", "scope"],
      "properties": {
        "path": { "$ref": "#/$defs/decisionPath" },
        "kind": { "const": "decision" },
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "status": { "const": "accepted" },
        "date": { "type": "string", "format": "date" },
        "scope": { "$ref": "#/$defs/scope" }
      }
    }
  }
}
